{
  "name": "@excalistack/server",
  "version": "0.1.0",
  "description": "excalistack REST API and static SPA host",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@excalistack/shared": "workspace:*",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
