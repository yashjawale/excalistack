{
  "name": "excalistack",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Excalidraw manager with server-side storage of multiple drawings",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @excalistack/shared build && pnpm --filter @excalistack/server dev",
    "dev:web": "pnpm --filter @excalistack/web dev",
    "start": "pnpm --filter @excalistack/server start",
    "test": "pnpm --filter @excalistack/server test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
